{
  "format": "figure-controls/1",
  "note": "Control value c in [-1,1]. c<0 applies the 'neg' side scaled by |c|; c>0 applies the 'pos' side scaled by c. Each side is a list of [target path relative to the MPFB targets dir without .target.gz, weight]. kind=macro controls are evaluated by MPFB macro-detail re-evaluation (piecewise linear about baseline) and exported as dense-then-sparsified deltas.",
  "controls": [
    {"name": "stature", "kind": "macro", "macro": "height", "baseline": 0.5, "neg_value": 0.0, "pos_value": 1.0,
     "desc": "overall height (MakeHuman macro 'height'; also moves proportions with the macro blend)"},
    {"name": "leg_length", "kind": "targets",
     "neg": [["legs/upperlegs-height-decr", 1.0], ["legs/lowerlegs-height-decr", 1.0]],
     "pos": [["legs/upperlegs-height-incr", 1.0], ["legs/lowerlegs-height-incr", 1.0]],
     "desc": "leg length (upper + lower leg height); with torso_length gives the torso/leg proportion"},
    {"name": "torso_length", "kind": "targets",
     "neg": [["torso/torso-scale-vert-decr", 1.0]], "pos": [["torso/torso-scale-vert-incr", 1.0]],
     "desc": "torso vertical scale"},
    {"name": "shoulder_breadth", "kind": "targets",
     "neg": [["torso/measure-shoulder-dist-decr", 1.0]], "pos": [["torso/measure-shoulder-dist-incr", 1.0]],
     "desc": "biacromial shoulder distance"},
    {"name": "ribcage", "kind": "targets",
     "neg": [["torso/measure-underbust-circ-decr", 1.0]], "pos": [["torso/measure-underbust-circ-incr", 1.0]],
     "desc": "underbust (ribcage) circumference"},
    {"name": "bust_projection", "kind": "targets",
     "neg": [["breast/breast-point-decr", 1.0]], "pos": [["breast/breast-point-incr", 1.0]],
     "desc": "breast point (forward projection)"},
    {"name": "bust_fullness", "kind": "targets",
     "neg": [["torso/measure-bust-circ-decr", 1.0]], "pos": [["torso/measure-bust-circ-incr", 1.0]],
     "desc": "bust circumference (fullness)"},
    {"name": "waist", "kind": "targets",
     "neg": [["torso/measure-waist-circ-decr", 1.0]], "pos": [["torso/measure-waist-circ-incr", 1.0]],
     "desc": "waist circumference"},
    {"name": "hip_breadth", "kind": "targets",
     "neg": [["hip/hip-scale-horiz-decr", 1.0]], "pos": [["hip/hip-scale-horiz-incr", 1.0]],
     "desc": "hip horizontal scale"},
    {"name": "glute_projection", "kind": "targets",
     "neg": [["buttocks/buttocks-volume-decr", 1.0]], "pos": [["buttocks/buttocks-volume-incr", 1.0]],
     "desc": "buttocks volume"},
    {"name": "thigh_fullness", "kind": "targets",
     "neg": [["legs/measure-thigh-circ-decr", 1.0]], "pos": [["legs/measure-thigh-circ-incr", 1.0]],
     "desc": "thigh circumference (both legs, symmetric target)"},
    {"name": "jaw_width", "kind": "targets",
     "neg": [["chin/chin-width-decr", 1.0]], "pos": [["chin/chin-width-incr", 1.0]],
     "desc": "the one face parameter: chin / jaw width"},
    {"name": "posture_lean", "kind": "targets",
     "neg": [["torso/torso-trans-backward", 1.0], ["neck/neck-trans-backward", 1.0]],
     "pos": [["torso/torso-trans-forward", 1.0], ["neck/neck-trans-forward", 1.0]],
     "desc": "the one posture parameter: torso + neck translate forward (+) or backward (-); MakeHuman has no kyphosis target, this is a lean"}
  ]
}
